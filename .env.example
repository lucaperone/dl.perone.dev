# HTTP Basic auth — the single shared secret gating the whole app.
AUTH_USER=admin
AUTH_PASS=change-me

# Port to listen on (behind the Infomaniak reverse proxy).
PORT=8080

# Optional: temp dir for per-request downloads (default: OS tmp).
# TMPDIR=/var/tmp

# Optional: kill a download after this many ms (default: 600000).
# DOWNLOAD_TIMEOUT_MS=600000

# Optional: explicit yt-dlp path (default: ./vendor/yt-dlp, else PATH).
# YTDLP_PATH=
